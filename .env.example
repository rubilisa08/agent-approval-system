# 이 파일을 복사해 .env 로 이름을 바꾸고 키를 채우세요. (.env 는 .gitignore에 있어 저장소에 올라가지 않습니다)
# 키가 하나도 없으면 offline(규칙 기반) 모드로 전체 흐름을 체험할 수 있습니다.

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# 강제로 고르기: openai | gemini | offline
# LLM_PROVIDER=

# 품질 검수 통과 기준 점수 (기본 80)
# QUALITY_THRESHOLD=80

# 재작성 요청 상한 (기본 2회) / 승인 대기 기한 (기본 3일)
# MAX_REVISIONS=2
# PENDING_SLA_DAYS=3
